<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Theme (Light) -->
    <style name="Theme.StatusSaver" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorSecondary">@color/app_accent</item>
        <item name="android:colorBackground">@color/light_background</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnPrimary">@color/light_background</item>
        <item name="colorOnSecondary">@color/light_background</item>
        <item name="colorOnBackground">@color/light_text_primary</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
        <item name="android:statusBarColor">@color/light_background</item>
        <item name="android:navigationBarColor">@color/light_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Dark Theme -->
    <style name="Theme.StatusSaver.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorSecondary">@color/app_accent</item>
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnPrimary">@color/light_background</item>
        <item name="colorOnSecondary">@color/light_background</item>
        <item name="colorOnBackground">@color/dark_text_primary</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Fullscreen Theme -->
    <style name="Theme.StatusSaver.FullScreen" parent="Theme.StatusSaver.Dark">
        <item name="android:windowFullscreen">false</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Dialog Theme -->
    <style name="Theme.StatusSaver.Dialog" parent="Theme.Material3.Light.Dialog">
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorSecondary">@color/app_accent</item>
    </style>

    <!-- Toolbar Title Style -->
    <style name="ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <!-- Tab Text Style -->
    <style name="CustomTabTextAppearance" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
